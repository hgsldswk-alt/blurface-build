    "settings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and help"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz und Hilfe"
          }
        },
        "zh-Hans": {
