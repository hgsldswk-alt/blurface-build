    "batch.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every photo. Only confirmed copies can be saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe jedes Foto. Nur bestätigte Kopien lassen sich sichern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请逐张复查，只有已确认的图片可以保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請逐張複查，只有已確認的圖片可以儲存。"
          }
        }
      }
    },
    "batch.sameLayout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue only if the photos use the same layout. Size and orientation must match. Review each result afterwards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre nur bei gleichem Layout fort. Größe und Ausrichtung müssen übereinstimmen. Prüfe danach jedes Ergebnis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认图片版式相同。只套用到尺寸、方向相同的照片，随后请逐张复查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認圖片版面相同。只套用至尺寸、方向相同的照片，之後請逐張複查。"
          }
        }
      }
    },
