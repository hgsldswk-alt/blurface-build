    "settings.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PixelVeil scans and edits on your iPhone. It adds a new copy to Photos only when you ask. Your original is kept, and image contents and recognized text are never sent to PixelVeil. Review the visible picture for addresses, faces or other details before sharing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PixelVeil sucht und bearbeitet auf deinem iPhone. Eine neue Kopie wird nur auf Wunsch in Fotos abgelegt. Das Original bleibt erhalten. Bilder und erkannter Text werden nicht an PixelVeil übertragen. Prüfe das sichtbare Foto vor dem Teilen auf Anschriften, Gesichter und andere Details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在 iPhone 上扫描和处理。只有你点保存时才添加新副本，原图保留，应用不接收照片或识别文字。分享前请检查画面里的住址、人脸和其他敏感内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片在 iPhone 上掃描及處理。只有你點選儲存時才加入新副本，原圖保留，App 不接收照片或辨識文字。分享前請檢查畫面上的地址、人臉和其他敏感內容。"
          }
        }
      }
    },
